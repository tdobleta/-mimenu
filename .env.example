# ============================================================
# mimenú — Variables de entorno
# Copiar este archivo a .env.local y completar los valores
# NUNCA commitear .env.local al repositorio
# ============================================================

# Supabase — obtener desde https://supabase.com/dashboard/project/[tu-proyecto]/settings/api
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Sentry - DSN publico del proyecto frontend, configurar por ambiente en Netlify/Vercel.
# No hardcodear valores de produccion dentro del codigo fuente.
VITE_SENTRY_DSN=

# Anthropic/OpenAI/Resend/MercadoPago/AFIP:
# Nunca usar prefijo VITE_ para credenciales privadas.
# Deben vivir como secrets de Supabase Edge Functions o del backend correspondiente.
